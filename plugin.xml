
<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-edit-plist-file"
    version="0.0.4">

    <name>Edit Plist file</name>

    <description>
        A cordova plugin to modify the iOS Info.plist file.
        Includes application localizations, encryption settings,
        camera and microphone usage descriptions.
    </description>

    <author>Haythem OUEDERNI - haythem@nirbyapp.com</author>
    <license>MIT</license>

    <engines>
        <engine name="cordova" version=">=3.5.0" />
    </engines>

    <!-- iOS -->
    <platform name="ios">

        <!-- Supported languages -->
        <config-file target="*-Info.plist"
            platform="ios"
            parent="CFBundleLocalizations"
            overwrite="true">
            <array>
                <string>es</string>
                <string>en</string>
                <string>pt</string>
                <string>fr</string>
                <string>it</string>
                <string>de</string>
                <string>bg</string>
                <string>cz</string>
                <string>nl</string>
                <string>pl</string>
                <string>ro</string>
                <string>sk</string>
            </array>
        </config-file>

        <!-- Camera permission -->
        <config-file target="*-Info.plist"
            platform="ios"
            parent="NSCameraUsageDescription">
            <string>This application needs access to the camera to take photos, record videos and scan QR codes and barcodes.</string>
        </config-file>

        <!-- Microphone permission -->
        <config-file target="*-Info.plist"
            platform="ios"
            parent="NSMicrophoneUsageDescription">
            <string>This application needs access to the microphone when recording videos.</string>
        </config-file>

        <!-- Encryption -->
        <config-file platform="ios"
            target="*-Info.plist"
            parent="ITSAppUsesNonExemptEncryption">
            <false/>
        </config-file>

        <!-- Development region -->
        <config-file platform="ios"
            target="*-Info.plist"
            parent="CFBundleDevelopmentRegion">
            <string>en-GB</string>
        </config-file>

    </platform>

</plugin>
